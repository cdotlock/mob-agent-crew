DATABASE_URL=postgres://mob:mob@localhost:5432/mob
MOB_HOST=0.0.0.0
MOB_PORT=4310
MOB_DATA_DIR=./data
MOB_EMBEDDED_WORKER=true
MOB_WORKER_CONCURRENCY=1
MOB_ENABLE_MOCK_DRIVER=true
MOB_SESSION_SECRET=replace-with-at-least-32-random-characters
MOB_ADMIN_EMAIL=admin@example.com
MOB_ADMIN_PASSWORD=replace-with-at-least-12-characters
MOB_ADMIN_NAME=Workspace Admin
MOB_BOOTSTRAP_REPOSITORY_URL=https://github.com/cdotlock/mob-agent-crew
MOB_AI_KEY=mob-replace-with-your-virtual-key
MOB_AI_BASE_URL=https://ai.mob-ai.cn/api
MOB_AI_MODEL=deepseek-v4-pro
MOB_AI_CLAUDE_MODEL=claude-opus-4-6:free
MOB_AI_CODEX_MODEL=gpt-5.6-sol
# Optional catalog overrides. By default Mob reads the Router's /v1/models endpoint.
# MOB_AI_MODEL_CATALOG_URL=https://ai.mob-ai.cn/api/v1/models
# MOB_AI_MODEL_CATALOG_JSON={"models":[{"id":"custom-alias","protocols":["openai-chat"]}]}
# MOB_AI_MODEL_CATALOG_TTL_SECONDS=300
